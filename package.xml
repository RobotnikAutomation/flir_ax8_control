<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flir_ax8_control</name>
  <version>1.0.0</version>
  <description>The flir_ax8_control package</description>
  <maintainer email="lgranat@robotnik.es">Łukasz Granat</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS 2 Python dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>flir_ax8_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>matplotlib</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
